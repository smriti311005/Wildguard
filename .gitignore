# ==========================================
# 1. DATASET & CACHES (Do not push to Git)
# ==========================================
dataset/images/
dataset/labels/
dataset/test/
dataset/train/
dataset/valid/
*.cache
*.db

# ==========================================
# 2. BASE DOWNLOADED PRE-TRAINED MODELS
# ==========================================
yolov8*.pt
yolo*.pt

# ==========================================
# 3. TRAINING RUN ARTIFACTS & BATCH VISUALIZATIONS
# ==========================================
# Ignore large batch visualization images generated during training
train_batch*.jpg
val_batch*.jpg

# Ignore intermediate training checkpoints (keep best.pt)
**/weights/last.pt

# Allow Git to track your best fine-tuned weights
!**/weights/best.pt

# ==========================================
# 4. PYTHON & ENVIRONMENT ARTIFACTS
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*

# OS & Editor Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# 5. REACT FRONTEND BUILD ARTIFACTS
# ==========================================
react_frontend/node_modules/
react_frontend/dist/
react_frontend/.vite/